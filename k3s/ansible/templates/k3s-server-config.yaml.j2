---
node-name: "{{ inventory_hostname }}"
node-ip: "{{ k3s_node_ip }}"
advertise-address: "{{ k3s_node_ip }}"
tls-san:
  - "{{ inventory_hostname }}"
  - "{{ k3s_controller_admin_endpoint }}"
  - "{{ k3s_node_ip }}"
cluster-cidr: "{{ k3s_cluster_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
cluster-domain: "{{ k3s_cluster_domain }}"
flannel-backend: vxlan
flannel-iface: "{{ k3s_cluster_interface }}"
secrets-encryption: true
agent-token-file: /etc/rancher/k3s/agent-token
write-kubeconfig-mode: "0600"
disable:
{% for component in k3s_disabled_components %}
  - "{{ component }}"
{% endfor %}
node-taint:
  - node-role.kubernetes.io/control-plane=true:NoSchedule

